# Copy these into Vercel: Project > Settings > Environment Variables.
# Nothing here is ever sent to the browser. For local work copy this file to .env.local (git-ignored).
#
# The site works with NONE of these set: the final buttons then open a ready-to-send email draft.
# Add them to also save every order and enquiry and to email KORE automatically.

# 1. Database (saves orders and enquiries).
#    Vercel > Storage > Create > Upstash Redis (Marketplace), connect it to this project.
#    It adds the variables below for you. Either naming is understood.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 2. Automatic email to KORE and an acknowledgement to the customer (Resend, https://resend.com).
#    Leave blank to save orders without sending email from the server.
RESEND_API_KEY=
# A sender on a domain you verified in Resend
FROM_EMAIL="KORE Gifting Studio <orders@your-domain.in>"
# Where new orders and enquiries are emailed (comma-separate several)
BUSINESS_EMAIL=koreexpression@gmail.com
# Email the customer an acknowledgement too (true / false)
SEND_CUSTOMER_ACK=true

# Local development only (npm run dev uses local files instead of Redis)
PORT=8080
